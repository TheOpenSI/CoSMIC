
# cp .env.example .env
# .env is gitignored; only this template is committed. Values shown are the
# in-code defaults, so an unset variable falls back to the same behaviour.

# Docker service name / host for the Ollama server.
OLLAMA_SERVICE_NAME=ollama

# Vector database
QDRANT_URL=http://qdrant:6333

# Embedding model
RAG_EMBEDDING_MODEL=gte-small

# Similarity at/above which incoming content is treated as a duplicate and skipped
# when writing to the vector store 
RAG_UPDATE_THRESHOLD=0.98


# Drop retrieved chunks whose similarity score is below this threshold
RAG_RETRIEVE_SCORE_THRESHOLD=0.0

# Number of chunks returned to the LLM after retrieval (and after reranking,
# if enabled).
RAG_TOPK=5


# Cross-encoder reranking for two stage reranking
RAG_RERANK_ENABLED=true

# Cross-encoder model used for reranking
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Number of dense candidates fetched before reranking
RAG_CANDIDATE_POOL=30

# Number of chunks kept after reranking
RAG_RERANK_TOPK=5

# Drop reranked chunks whose cross-encoder score is below this threshold
RAG_RERANK_SCORE_THRESHOLD=0.0

# Base URL the pipeline uses to reach the CoSMIC API.
OPENSI_COSMIC_API_BASE_URL=http://cosmic:3000

# Max queries per non-admin user.
MAX_QUERIES_PER_USER=5
